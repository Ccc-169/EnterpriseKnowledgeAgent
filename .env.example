# LLM 配置
QWEN_API_KEY=sk-your-key-here

# Dify 知识库
DIFY_DATASET_KEY=dataset-your-key-here
DIFY_KB_ID=your-kb-id-here
# Dify API 地址（可选，默认为 https://api.dify.ai/v1，自建实例请修改为对应地址）
DIFY_API_BASE=https://api.dify.ai/v1

# 代码沙箱地址
EXECUTOR_URL=http://localhost:8001/execute

# 进程池大小（预热 Worker 数量，默认 min(4, CPU核心数)，0 表示自动）
EXECUTOR_POOL_SIZE=4

# Excel 数据文件目录
DATA_DIR=./data/files

# 安全配置（上线前必须修改 SECRET_KEY）
SECRET_KEY=change-this-to-a-random-32-char-string

# Token 有效期（分钟，默认8小时）
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 数据库路径
DB_PATH=./data/hngd.db

# LangSmith 可观测性（可选，接入后可追踪 LLM 调用链路）
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxx
LANGCHAIN_PROJECT=hngd-backend
