import streamlit as st
from agent import chat

st.set_page_config(page_title="企业知识库智能体", layout="wide")
st.title("🏢 企业知识库智能体")
st.caption("支持文档问答 · 数据统计 · 内容仿写")

# 初始化对话历史
if "messages" not in st.session_state:
    st.session_state.messages = []
if "thread_id" not in st.session_state:
    st.session_state.thread_id = "demo-session-001"

# 渲染历史消息
for msg in st.session_state.messages:
    with st.chat_message(msg["role"]):
        st.markdown(msg["content"])

# 输入框
if user_input := st.chat_input("请输入您的问题..."):
    st.session_state.messages.append({"role": "user", "content": user_input})
    with st.chat_message("user"):
        st.markdown(user_input)

    with st.chat_message("assistant"):
        with st.spinner("思考中..."):
            response, steps = chat(user_input, st.session_state.thread_id)
        
        # 折叠显示思考过程，不影响主界面整洁
        if steps:
            with st.expander("🧠 查看推理过程", expanded=False):
                for step in steps:
                    st.markdown(step)
        
        st.markdown(response)

    st.session_state.messages.append({"role": "assistant", "content": response})

# 终端二：Web 界面 streamlit run app.py