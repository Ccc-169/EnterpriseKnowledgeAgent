{
  "groups": [
    {
      "id": "g-alarm",
      "name": "报警管理",
      "open": true
    },
    {
      "id": "g-device",
      "name": "设备管理",
      "open": true
    },
    {
      "id": "g-hazard",
      "name": "安全隐患",
      "open": true
    },
    {
      "id": "g-monitor",
      "name": "实时监测",
      "open": true
    },
    {
      "id": "g-workorder",
      "name": "工单管理",
      "open": true
    }
  ],
  "interfaces": [
    {
      "id": "i-alarm-count",
      "groupId": "g-alarm",
      "name": "报警数量统计",
      "method": "GET",
      "url": "http://localhost:8002/api/alarms/count",
      "enabled": true,
      "params": [
        {
          "key": "start_date",
          "value": "2025-01-01",
          "enabled": true,
          "desc": "查询开始日期，格式 YYYY-MM-DD。【今年】【本月】【最近N天】等需转换为具体日期"
        },
        {
          "key": "end_date",
          "value": "2025-06-30",
          "enabled": true,
          "desc": "查询结束日期，格式 YYYY-MM-DD。【当前】【今天】【截至今日】填今日日期"
        },
        {
          "key": "level",
          "value": "1",
          "enabled": false,
          "desc": "报警等级筛选（整数）：0=低级，1=中级，2=高级；不传则统计全部等级"
        }
      ],
      "headers": [],
      "bodyType": "none",
      "body": "",
      "bodyText": "",
      "formRows": [],
      "authType": "none",
      "authValue": "",
      "authKeyName": "X-API-Key",
      "authUser": "",
      "authPass": ""
    },
    {
      "id": "i-device-status",
      "groupId": "g-device",
      "name": "设备状态查询",
      "method": "GET",
      "url": "http://localhost:8002/api/devices/status",
      "enabled": true,
      "params": [
        {
          "key": "area",
          "value": "A区",
          "desc": "按区域筛选，如 A区、B区、C区；不传则返回全部区域",
          "enabled": true
        },
        {
          "key": "status",
          "value": "warning",
          "desc": "按状态筛选：normal=正常，warning=告警，error=故障；不传则返回全部状态",
          "enabled": true
        },
        {
          "key": "page",
          "value": "1",
          "desc": "分页页码，从 1 开始",
          "enabled": true
        },
        {
          "key": "page_size",
          "value": "10",
          "desc": "每页返回的设备数量，默认 10，最大 100",
          "enabled": true
        }
      ],
      "headers": [],
      "bodyType": "none",
      "body": "",
      "bodyText": "",
      "formRows": [],
      "authType": "none",
      "authValue": "",
      "authKeyName": "X-API-Key",
      "authUser": "",
      "authPass": ""
    },
    {
      "id": "i-hazard-report",
      "groupId": "g-hazard",
      "name": "安全隐患上报",
      "method": "POST",
      "url": "http://localhost:8002/api/hazard/report",
      "enabled": true,
      "params": [],
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json",
          "enabled": true
        }
      ],
      "bodyType": "json",
      "body": "{\n  \"location\": \"C区-化工车间3号房\",\n  \"description\": \"地面有油渍，存在滑倒风险\",\n  \"level\": 1,\n  \"reporter\": \"张三\",\n  \"area\": \"C区-化工车间\"\n}",
      "bodyText": "",
      "formRows": [],
      "authType": "none",
      "authValue": "",
      "authKeyName": "X-API-Key",
      "authUser": "",
      "authPass": ""
    },
    {
      "id": "i-monitor-realtime",
      "groupId": "g-monitor",
      "name": "传感器实时监测数据",
      "method": "GET",
      "url": "http://localhost:8002/api/monitor/realtime",
      "enabled": true,
      "params": [
        {
          "key": "area",
          "value": "C区",
          "desc": "监测区域，如 A区、B区、C区；不传则返回全部区域的传感器数据",
          "enabled": true
        },
        {
          "key": "metric",
          "value": "co",
          "desc": "监测指标：co=一氧化碳，temperature=温度，humidity=湿度，smoke=烟雾；不传则返回全部指标",
          "enabled": true
        },
        {
          "key": "state",
          "value": "warning",
          "desc": "预警状态：normal=正常，warning=预警，critical=危险；不传则返回全部状态",
          "enabled": true
        }
      ],
      "headers": [],
      "bodyType": "none",
      "body": "",
      "bodyText": "",
      "formRows": [],
      "authType": "none",
      "authValue": "",
      "authKeyName": "X-API-Key",
      "authUser": "",
      "authPass": ""
    },
    {
      "id": "i-workorder-stats",
      "groupId": "g-workorder",
      "name": "工单统计",
      "method": "GET",
      "url": "http://localhost:8002/api/workorder/stats",
      "enabled": true,
      "params": [
        {
          "key": "start_date",
          "value": "2025-01-01",
          "enabled": true,
          "desc": "统计开始日期，格式 YYYY-MM-DD。【今年】【本月】等需转换为具体日期"
        },
        {
          "key": "end_date",
          "value": "2025-06-30",
          "enabled": true,
          "desc": "统计结束日期，格式 YYYY-MM-DD。【当前】【今天】填今日日期"
        },
        {
          "key": "type",
          "value": "maintenance",
          "enabled": false,
          "desc": "工单类型：maintenance=维护，repair=维修，inspection=巡检；不传则统计全部类型"
        }
      ],
      "headers": [],
      "bodyType": "none",
      "body": "",
      "bodyText": "",
      "formRows": [],
      "authType": "none",
      "authValue": "",
      "authKeyName": "X-API-Key",
      "authUser": "",
      "authPass": ""
    }
  ]
}